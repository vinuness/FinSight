<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinSight</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FinSight.Web.styles.css" asp-append-version="true" />
</head>
<body>

    @if(ViewData["HideSide"] as bool? != true){
    <aside>
        <ul class="m-3 list-unstyled">
            <li>
                <a asp-action="Index"
                   asp-controller="Home">
                    Home
                </a>
            </li>
            @if(User.Identity != null && User.Identity.IsAuthenticated){
            <hr />
            <li>
                <a asp-action="Index"
                   asp-controller="Meta">
                    Metas
                </a>
            </li>
            }
        </ul>
        @if(User.Identity != null && User.Identity.IsAuthenticated){
            <div class="dropdown mt-auto w-100 d-flex justify-content-center mb-3">
                <a href="#"
                class="d-flex align-items-center text-decoration-none dropdown-toggle text-white"
                id="dropdownUser"
                data-bs-toggle="dropdown"
                aria-expanded="false">

                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30   " fill="currentColor" class="bi bi-person-circle" viewBox="0 0 16 16">
                        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
                        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
                    </svg>

                </a>
                <ul class="dropdown-menu shadow"
                    aria-labelledby="dropdownUser">
                    <li>
                        <a asp-controller="User" asp-action="Perfil" class="dropdown-item">
                            Perfil
                        </a>
                    </li>
                    <li>
                        <hr class="dropdown-divider">
                    </li>
                    <li>
                        <a asp-controller="User" asp-action="Logout" class="dropdown-item">
                            Sair
                        </a>
                    </li>
                </ul>
            </div>
        }else{
            <div class="mt-auto w-100 d-flex justify-content-center mb-3">
                <ul class="list-unstyled">
                    <li>
                        <a asp-controller="User" asp-action="Login">Entrar</a>
                    </li>
                    <li>
                        <a asp-controller="User" asp-action="Cadastrar">Cadastrar</a>
                    </li>
                </ul>
            </div>
        }
    </aside>
}
    <div class="page-content @(ViewData["HideSide"] as bool? == true ? "no-sidebar" : "")">

        <main role="main">
            @RenderBody()
        </main>

        <footer>
            <div class="container">
                &copy; 2026 - FinSight -
                <a asp-controller="Home"asp-action="Privacy">Privacy</a></div>
        </footer>
    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>