@model FinSight.Web.Models.Metas.MetaDTO

@{
    ViewData["Title"] = "Nova Meta";
}

<div class="form-page">

    <div class="form-header">
        <a asp-controller="Meta"
           asp-action="Index"
           class="back-link">
            ← Voltar
        </a>

        <h1>Nova Meta</h1>

        <p>
            Crie um objetivo financeiro para acompanhar seu progresso.
        </p>
    </div>

    <div class="meta-form-card">

        <form asp-controller="Meta"
              asp-action="Create"
              method="post">

            <input type="hidden"
                   asp-for="UsuarioId"/>

            <div class="form-group">

                <label asp-for="Nome">
                    Nome da meta
                </label>

                <input asp-for="Nome"
                       class="form-control"
                       placeholder="Ex: Comprar um carro" />

                <span asp-validation-for="Nome"
                      class="validation-message">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Descricao">
                    Descrição
                </label>

                <textarea asp-for="Descricao"
                          class="form-control"
                          rows="4"
                          placeholder="Descreva sua meta...">
                </textarea>

                <span asp-validation-for="Descricao"
                      class="validation-message">
                </span>

            </div>

            <div class="form-row">

                <div class="form-group">

                    <label asp-for="ValorAtual">
                        Valor atual
                    </label>

                    <input asp-for="ValorAtual"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="0,00" />

                    <span asp-validation-for="ValorAtual"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="ValorDesejado">
                        Valor desejado
                    </label>

                    <input asp-for="ValorDesejado"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0"
                           placeholder="10000,00" />

                    <span asp-validation-for="ValorDesejado"
                          class="validation-message">
                    </span>

                </div>

            </div>

            <div class="form-actions">

                <a asp-controller="Meta"
                   asp-action="Index"
                   class="btn-cancel">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn-save">
                    Criar Meta
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}