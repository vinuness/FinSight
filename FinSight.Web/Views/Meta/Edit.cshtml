@model FinSight.Web.Models.Metas.MetaUpdate

@{
    ViewData["Title"] = "Editar Meta";
}

<div class="form-page">

    <div class="form-header">

        <a asp-controller="Meta"
           asp-action="Index"
           class="back-link">
            ← Voltar
        </a>

        <h1>Editar Meta</h1>

        <p>
            Atualize as informações da sua meta financeira.
        </p>

    </div>

    <div class="meta-form-card">

        <form asp-controller="Meta"
              asp-action="Edit"
              method="post">

            <div class="form-group">

                <label asp-for="Nome">
                    Nome da meta
                </label>

                <input asp-for="Nome"
                       class="form-control"
                       placeholder="Nome da meta" />

                <span asp-validation-for="Nome"
                      class="validation-message">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="Descricao">
                    Descrição
                </label>

                <textarea asp-for="Descricao"
                          class="form-control"
                          rows="4"
                          placeholder="Descrição da meta">
                </textarea>

                <span asp-validation-for="Descricao"
                      class="validation-message">
                </span>

            </div>

            <div class="form-row">

                <div class="form-group">

                    <label asp-for="ValorAtual">
                        Valor atual
                    </label>

                    <input asp-for="ValorAtual"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0" />

                    <span asp-validation-for="ValorAtual"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="ValorDesejado">
                        Valor desejado
                    </label>

                    <input asp-for="ValorDesejado"
                           class="form-control"
                           type="number"
                           step="0.01"
                           min="0" />

                    <span asp-validation-for="ValorDesejado"
                          class="validation-message">
                    </span>

                </div>

            </div>

            <div class="form-actions">

                <a asp-controller="Meta"
                   asp-action="Index"
                   class="btn-cancel">
                    Cancelar
                </a>

                <button type="submit"
                        class="btn-save">
                    Salvar alterações
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}