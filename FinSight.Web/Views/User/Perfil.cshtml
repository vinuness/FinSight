@model FinSight.Web.Models.Usuario.Usuario
@{
    ViewData["Title"] = "Perfil";
    var cliente = Model;
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-success text-white text-center rounded-top-4">
                    <h3 class="mb-0">Meu Perfil</h3>
                </div>

                <div class="card-body p-4">

                    <h5 class="mb-3 text-secondary">Informações pessoais</h5>

                    <div class="mb-2">
                        <span class="d-none" id="id"></span>
                    </div>

                    <div class="mb-2">
                        <strong>Nome:</strong> @cliente.Nome <span id="nome"></span>
                    </div>

                    <div class="mb-4">
                        <strong>Email:</strong> @cliente.Email <span id="email"></span>
                    </div>
        </div>

    </div>

</div>